# Vite loads this file in `npm run dev` (mode=development).
#
# The scheme is NOT optional. `localhost:3001` parses as a URL whose *scheme* is
# `localhost:`, so Firefox refuses the request before it is ever sent, with
# "CORS request not http" — a message that names CORS but is really "that is not
# an http URL". Chrome reports it as a failed fetch instead. Always `http://`.
VITE_API_BASE_URL=http://localhost:3001

# Public app root used to build shareable catalog links.
# Vite dev serves on 5173 (not 5137).
VITE_PUBLIC_APP_URL=http://localhost:5173

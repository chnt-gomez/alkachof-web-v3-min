# Copy to .env.local to override a value locally. Vite only exposes vars
# prefixed with VITE_ to the client bundle.

# API origin. Also the Socket.IO host for the /live namespace.
# Point at http://localhost:3001 to run against a local alkachof-api.
VITE_API_BASE_URL=https://api.alkachof.mx

# Public app root, used to build shareable catalog/product links.
VITE_PUBLIC_APP_URL=https://app.alkachof.mx


# Loaded by `npm run build` (Vite mode=production). Without this file the
# fallbacks in src/lib/api.ts and src/lib/shareUrl.ts are what ship.
VITE_DEV_STAGE=false
VITE_API_BASE_URL=https://api.alkachof.mx
VITE_PUBLIC_APP_URL=https://app.alkachof.mx

# Phyllo Connect environment for the Instagram import. MUST match the API's
# PHYLLO_ENV, which needs PHYLLO_ENV=production for real accounts.
VITE_PHYLLO_ENV=production
